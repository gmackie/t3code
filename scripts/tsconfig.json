{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "lib": ["ESNext", "esnext.disposable"]
  },
  "include": ["**/*.ts"],
  // The reverse smoke scripts import apps/server modules, which this composite project cannot
  // contain; reverse-workbench.yml runs them against the real tools instead.
  "exclude": ["reverse-ghidra-smoke.ts", "reverse-runtime-smoke.ts"]
}
