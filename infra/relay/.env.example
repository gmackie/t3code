# Required: Relay API and managed tunnel domains
# Production adopts retained DNS zones in your Cloudflare account. The API
# zone serves relay.<zone> in production and relay-<stage>.<zone> for personal
# stages. Managed environment endpoints are provisioned below the tunnel zone.
RELAY_API_ZONE_NAME=example.com
RELAY_TUNNEL_ZONE_NAME=tunnels.example.com

# Optional: inactive tunnel cleanup. Start with dry-run, verify the cleanup
# logs, then set enabled. Unset and off both disable cleanup.
# RELAY_TUNNEL_CLEANUP_MODE=off
# Optional: cleanup for tunnels whose host never registered recovery, once they
# have been down for 30 days. Same values, independent of the mode above.
# RELAY_LEGACY_TUNNEL_CLEANUP_MODE=off
# Canary stages only: shorten the 30-day legacy grace period, in minutes.
# Ignored on prod.
# RELAY_LEGACY_TUNNEL_GRACE_MINUTES=10

# Optional: managed endpoint provider for new link reconciliations.
# Cloudflare Tunnel remains the default. T3 relay is an opt-in canary until the
# rollout checks in docs/operations/t3-relay-canary.md have been completed.
# RELAY_MANAGED_ENDPOINT_PROVIDER=t3_relay

# Optional: relay monitors and health dashboard in Axiom. Set the notifier id
# that pages (incident.io in prod) to create them; unset creates neither, so
# personal stages never page anyone. Warnings go to their own notifier, or
# only show in Axiom when it is unset.
# RELAY_ALERT_NOTIFIER_ID=
# RELAY_WARNING_NOTIFIER_ID=

# Optional: Relay domain override
# Set this only when the derived relay hostname should not be used.
# RELAY_DOMAIN=relay.example.com

# Clerk, or Nathan. Upstream builds use Clerk. A gmacko build sets the OIDC
# variables and leaves the Clerk keys empty; a Clerk token is then rejected.
# Get the Clerk keys from the Clerk Dashboard under API keys. Set the JWT
# audience to the `aud` claim configured on the `t3-relay` JWT template.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_AUDIENCE=t3-code-relay

# Nathan (gmacko). Issuer is the discovery base, including /api/auth.
# OIDC_AUDIENCE is the public client id. Leave OIDC_ALLOWED_SUBJECT unset until
# the first real `sub` is known, then set it so a second Nathan user cannot link.
# OIDC_ISSUER=https://id.gmac.io/api/auth
# OIDC_AUDIENCE=
# OIDC_ALLOWED_SUBJECT=

# Postgres origin for Hyperdrive when PlanetScale credentials are absent.
# Cloudflare must be able to reach this host. A Tailscale-only name will not work.
# RELAY_DATABASE_URL=postgres://user:password@host:5432/relay

# Apple Push Notification service (required unless APNS_ENABLED=false)
# The gmacko relay sets APNS_ENABLED=false. It does not send mobile push.
# Set APNS_ENABLED=false for an Android-only development relay.
# Get these values from your Apple Developer account. Use `sandbox` for
# development APNs credentials and `production` for production credentials.
APNS_ENVIRONMENT=sandbox
APNS_TEAM_ID=...
APNS_KEY_ID=...
APNS_BUNDLE_ID=...
APNS_PRIVATE_KEY=...

# Optional: Android push. Set this secret to the service account JSON from
# Firebase Project settings > Service accounts. Never put it in an app build.
# FCM_SERVICE_ACCOUNT={...}
